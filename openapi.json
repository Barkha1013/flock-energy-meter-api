{
  "openapi": "3.1.0",
  "info": {
    "title": "Flock Meter Data API",
    "description": "A read API for Urja Meter Ops meter, transformer, network-hierarchy, and energy data. Run `python -m app.sync` to refresh meter and transformer data from the portal.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/meters": {
      "get": {
        "tags": [
          "meter data"
        ],
        "summary": "List synchronized meters",
        "operationId": "meters_api_v1_meters_get",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Substring match for meter ID or serial number",
              "title": "Search"
            },
            "description": "Substring match for meter ID or serial number"
          },
          {
            "name": "install_status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Exact portal installation status",
              "title": "Install Status"
            },
            "description": "Exact portal installation status"
          },
          {
            "name": "make",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Exact manufacturer match",
              "title": "Make"
            },
            "description": "Exact manufacturer match"
          },
          {
            "name": "phase_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Exact phase type: single or three",
              "title": "Phase Type"
            },
            "description": "Exact phase type: single or three"
          },
          {
            "name": "dt_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Distribution-transformer code",
              "title": "Dt Code"
            },
            "description": "Distribution-transformer code"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters/{meter_id}": {
      "get": {
        "tags": [
          "meter data"
        ],
        "summary": "Get a meter and its network path",
        "operationId": "meter_api_v1_meters__meter_id__get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/transformers": {
      "get": {
        "tags": [
          "meter data"
        ],
        "summary": "List distribution transformers",
        "operationId": "transformers_api_v1_transformers_get",
        "parameters": [
          {
            "name": "feeder_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Feeder Code"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransformerPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters/{meter_id}/readings": {
      "get": {
        "tags": [
          "meter data"
        ],
        "summary": "Get recent meter energy readings",
        "operationId": "readings_api_v1_meters__meter_id__readings_get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Inclusive ISO 8601 timestamp",
              "title": "Start"
            },
            "description": "Inclusive ISO 8601 timestamp"
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Inclusive ISO 8601 timestamp",
              "title": "End"
            },
            "description": "Inclusive ISO 8601 timestamp"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReadingOut"
                  },
                  "title": "Response Readings Api V1 Meters  Meter Id  Readings Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Check service availability",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MeterDetail": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "serial_number": {
            "type": "string",
            "title": "Serial Number"
          },
          "make": {
            "type": "string",
            "title": "Make"
          },
          "phase_type": {
            "type": "string",
            "title": "Phase Type"
          },
          "install_status": {
            "type": "string",
            "title": "Install Status"
          },
          "install_type": {
            "type": "string",
            "title": "Install Type"
          },
          "build": {
            "type": "string",
            "title": "Build"
          },
          "dt_code": {
            "type": "string",
            "title": "Dt Code"
          },
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "title": "Longitude"
          },
          "network_hierarchy": {
            "items": {
              "$ref": "#/components/schemas/NetworkNodeOut"
            },
            "type": "array",
            "title": "Network Hierarchy"
          }
        },
        "type": "object",
        "required": [
          "id",
          "serial_number",
          "make",
          "phase_type",
          "install_status",
          "install_type",
          "build",
          "dt_code",
          "latitude",
          "longitude",
          "network_hierarchy"
        ],
        "title": "MeterDetail"
      },
      "MeterOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "serial_number": {
            "type": "string",
            "title": "Serial Number"
          },
          "make": {
            "type": "string",
            "title": "Make"
          },
          "phase_type": {
            "type": "string",
            "title": "Phase Type"
          },
          "install_status": {
            "type": "string",
            "title": "Install Status"
          },
          "install_type": {
            "type": "string",
            "title": "Install Type"
          },
          "build": {
            "type": "string",
            "title": "Build"
          },
          "dt_code": {
            "type": "string",
            "title": "Dt Code"
          },
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "title": "Longitude"
          }
        },
        "type": "object",
        "required": [
          "id",
          "serial_number",
          "make",
          "phase_type",
          "install_status",
          "install_type",
          "build",
          "dt_code",
          "latitude",
          "longitude"
        ],
        "title": "MeterOut"
      },
      "MeterPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MeterOut"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "MeterPage"
      },
      "NetworkNodeOut": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "node_type": {
            "type": "string",
            "title": "Node Type"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "name",
          "node_type",
          "parent_id"
        ],
        "title": "NetworkNodeOut"
      },
      "ReadingOut": {
        "properties": {
          "recorded_at": {
            "type": "string",
            "title": "Recorded At"
          },
          "kwh": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kwh"
          },
          "kvah": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kvah"
          },
          "voltage_r": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voltage R"
          }
        },
        "type": "object",
        "required": [
          "recorded_at",
          "kwh",
          "kvah",
          "voltage_r"
        ],
        "title": "ReadingOut"
      },
      "TransformerOut": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "feeder_code": {
            "type": "string",
            "title": "Feeder Code"
          },
          "capacity_kva": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Capacity Kva"
          }
        },
        "type": "object",
        "required": [
          "code",
          "name",
          "feeder_code",
          "capacity_kva"
        ],
        "title": "TransformerOut"
      },
      "TransformerPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TransformerOut"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "TransformerPage"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
